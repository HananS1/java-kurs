 "captions": [
  {
   "start": 0,
   "end": 2.46,
   "text": "Dieser Junge wollte sich nur kurz die Katzen anschauen.",
   "highlight": [
    "Katzen"
   ]
  },
  {
   "start": 2.46,
   "end": 4.43,
   "text": "Doch dann klettert diese hier aus dem Käfig.",
   "highlight": [
    "Käfig."
   ]
  },
  {
   "start": 4.43,
   "end": 5.59,
   "text": "Direkt auf seine Schulter.",
   "highlight": [
    "Schulter."
   ]
  },
  {
   "start": 5.59,
   "end": 6.71,
   "text": "Und lässt nicht mehr los.",
   "highlight": [
    "los."
   ]
  },
  {
   "start": 6.71,
   "end": 9.31,
   "text": "Sie krallt sich fest und drückt ihren Kopf an seinen Hals.",
   "highlight": [
    "fest",
    "Hals."
   ]
  },
  {
   "start": 9.31,
   "end": 10.07,
   "text": "Er dreht sich um…",
   "highlight": []
  },
  {
   "start": 10.07,
   "end": 11.86,
   "text": "und kann nicht mehr aufhören zu grinsen.",
   "highlight": [
    "grinsen."
   ]
  },
  {
   "start": 11.86,
   "end": 14.85,
   "text": "Sie kuschelt sich an ihn, als würden sie sich schon ewig kennen.",
   "highlight": [
    "ewig"
   ]
  },
  {
   "start": 14.85,
   "end": 16.5,
   "text": "Er wollte eine Katze aussuchen.",
   "highlight": [
    "Katze"
   ]
  },
  {
   "start": 16.55,
   "end": 17.37,
   "text": "Aber sie hat ihn ausgesucht.",
   "highlight": [
    "ihn"
   ]
  }
 ],
