    {"start": 3.90, "end": 5.72, "text": "Auf Feldern, die gar nicht da sind.", "highlight": ["nicht"]},
    {"start": 5.97, "end": 7.13, "text": "Der Ladenbesitzer sieht das –", "highlight": ["Ladenbesitzer"]},
    {"start": 7.23, "end": 8.23, "text": "und klebt ihr über Nacht", "highlight": []},
    {"start": 8.35, "end": 9.52, "text": "echte Felder auf den Boden.", "highlight": ["echte"]},
    {"start": 9.66, "end": 10.28, "text": "Sie kommt zurück…", "highlight": []},
    {"start": 10.43, "end": 11.67, "text": "und springt sofort los.", "highlight": ["sofort"]},
    {"start": 11.79, "end": 13.49, "text": "Doch dann kommt ein erwachsener Mann rein.", "highlight": ["erwachsener", "Mann"]},
    {"start": 13.61, "end": 14.29, "text": "Schaut nach links.", "highlight": ["links"]},
    {"start": 14.41, "end": 14.91, "text": "Nach rechts.", "highlight": ["rechts"]},
    {"start": 15.06, "end": 15.88, "text": "Sucht die Kameras.", "highlight": ["Kameras"]},
    {"start": 15.98, "end": 17.42, "text": "Als würde er gleich was klauen.", "highlight": ["klauen"]},
    {"start": 17.55, "end": 18.50, "text": "Und das tut er auch.", "highlight": []},
    {"start": 18.62, "end": 19.91, "text": "Er klaut sich einen Moment…", "highlight": ["Moment"]},
