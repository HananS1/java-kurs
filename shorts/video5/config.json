 "captions": [
  {
   "start": 0.0,
   "end": 2.22,
   "text": "Die U-Bahn-Tür geht direkt vor seiner Nase zu.",
   "highlight": [
    "Nase",
    "zu."
   ]
  },
  {
   "start": 2.22,
   "end": 3.74,
   "text": "Aber dieser Opa gibt nicht auf.",
   "highlight": [
    "Opa"
   ]
  },
  {
   "start": 3.74,
   "end": 5.38,
   "text": "Er klemmt seinen Stock in die Tür.",
   "highlight": [
    "Stock"
   ]
  },
  {
   "start": 5.38,
   "end": 6.31,
   "text": "Und zieht. Und zieht.",
   "highlight": [
    "zieht.",
    "zieht."
   ]
  },
  {
   "start": 6.31,
   "end": 8.32,
   "text": "Dann kommt ein junger Mann angelaufen.",
   "highlight": [
    "Mann"
   ]
  },
  {
   "start": 8.32,
   "end": 9.06,
   "text": "Endlich Hilfe!",
   "highlight": [
    "Hilfe!"
   ]
  },
  {
   "start": 9.06,
   "end": 10.78,
   "text": "Zusammen reißen sie die Tür auf…",
   "highlight": [
    "auf…"
   ]
  },
  {
   "start": 10.78,
   "end": 12.12,
   "text": "und der junge Mann steigt ein.",
   "highlight": [
    "Mann",
    "steigt"
   ]
  },
  {
   "start": 12.12,
   "end": 13.02,
   "text": "Die Tür geht zu.",
   "highlight": [
    "zu."
   ]
  },
  {
   "start": 13.02,
   "end": 14.58,
   "text": "Der Opa steht immer noch draußen.",
   "highlight": [
    "Opa",
    "draußen."
   ]
  },
  {
   "start": 14.58,
   "end": 16.04,
   "text": "Und der Zug fährt ohne ihn los.",
   "highlight": [
    "ohne"
   ]
  },
  {
   "start": 16.04,
   "end": 17.28,
   "text": "Mister Bean wäre stolz.",
   "highlight": [
    "Bean"
   ]
  }
 ],
