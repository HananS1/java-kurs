[
 {
  "start": 0.0,
  "end": 2.22,
  "text": "Die U-Bahn-Tür geht direkt vor seiner Nase zu."
 },
 {
  "start": 2.22,
  "end": 3.74,
  "text": "Aber dieser Opa gibt nicht auf."
 },
 {
  "start": 3.74,
  "end": 5.38,
  "text": "Er klemmt seinen Stock in die Tür."
 },
 {
  "start": 5.38,
  "end": 6.31,
  "text": "Und zieht. Und zieht."
 },
 {
  "start": 6.31,
  "end": 8.32,
  "text": "Dann kommt ein junger Mann angelaufen."
 },
 {
  "start": 8.32,
  "end": 9.06,
  "text": "Endlich Hilfe!"
 },
 {
  "start": 9.06,
  "end": 10.78,
  "text": "Zusammen reißen sie die Tür auf…"
 },
 {
  "start": 10.78,
  "end": 12.12,
  "text": "und der junge Mann steigt ein."
 },
 {
  "start": 12.12,
  "end": 13.02,
  "text": "Die Tür geht zu."
 },
 {
  "start": 13.02,
  "end": 14.58,
  "text": "Der Opa steht immer noch draußen."
 },
 {
  "start": 14.58,
  "end": 16.04,
  "text": "Und der Zug fährt ohne ihn los."
 },
 {
  "start": 16.04,
  "end": 17.28,
  "text": "Mister Bean wäre stolz."
 }
]
