[{"first":"Santiago","at":0.0,"lines":["Santiago pennt mitten im Unterricht."]},
 {"first":"Und","at":5.6,"lines":["Und Santiago?","Stellt keine einzige Frage."]},
 {"first":"Er","at":12.0,"lines":["Er schnappt sich den Schwamm und wischt die Tafel","während der Lehrer noch draufschreibt."]},
