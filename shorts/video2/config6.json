 "captions": [
  {
   "start": 0,
   "end": 1.09,
   "text": "Dutzende Polizisten.",
   "highlight": [
    "Dutzende"
   ]
  },
  {
   "start": 1.24,
   "end": 2.15,
   "text": "Ein Fünfjähriger.",
   "highlight": [
    "Fünfjähriger"
   ]
  },
  {
   "start": 2.24,
   "end": 3.59,
   "text": "Und keiner sagt ein Wort.",
   "highlight": [
    "keiner"
   ]
  },
  {
   "start": 3.82,
   "end": 4.85,
   "text": "Was hat dieser Junge getan?",
   "highlight": [
    "getan?"
   ]
  },
  {
   "start": 4.91,
   "end": 5.39,
   "text": "Nichts.",
   "highlight": [
    "Nichts"
   ]
  },
  {
   "start": 5.48,
   "end": 7.53,
   "text": "Vor zwei Wochen hat er seinen Papa verloren.",
   "highlight": [
    "Papa",
    "verloren"
   ]
  },
  {
   "start": 7.63,
   "end": 9.61,
   "text": "Rob war 16 Jahre lang Polizist.",
   "highlight": [
    "16"
   ]
  },
  {
   "start": 9.78,
   "end": 10.83,
   "text": "Und starb im Einsatz.",
   "highlight": [
    "starb"
   ]
  },
  {
   "start": 10.92,
   "end": 13.1,
   "text": "Heute ist Dakotas erster Schultag ohne ihn.",
   "highlight": [
    "ohne",
    "ihn"
   ]
  },
  {
   "start": 13.22,
   "end": 15.16,
   "text": "Und diesen Weg sollte er nicht allein gehen.",
   "highlight": [
    "allein"
   ]
  },
  {
   "start": 15.26,
   "end": 17.39,
   "text": "Also kam seine ganze Polizei-Familie.",
   "highlight": [
    "Polizei-Familie"
   ]
  },
  {
   "start": 17.63,
   "end": 18.53,
   "text": "Für seinen Papa.",
   "highlight": [
    "Papa"
   ]
  }
 ],
