  {
   "start": 0.0,
   "end": 1.14,
   "text": "Dutzende Polizisten.",
   "highlight": [
    "Dutzende"
   ]
  },
  {
   "start": 1.38,
   "end": 2.21,
   "text": "Ein Fünfjähriger.",
   "highlight": [
    "Fünfjähriger"
   ]
  },
  {
   "start": 2.31,
   "end": 3.65,
   "text": "Und keiner sagt ein Wort.",
   "highlight": [
    "keiner"
   ]
  },
  {
   "start": 3.82,
   "end": 4.96,
   "text": "Was hat dieser Junge getan?",
   "highlight": [
    "getan?"
   ]
  },
  {
   "start": 5.12,
   "end": 5.65,
   "text": "Nichts.",
   "highlight": [
    "Nichts"
   ]
  },
  {
   "start": 5.73,
   "end": 7.62,
   "text": "Vor zwei Wochen hat er seinen Papa verloren.",
   "highlight": [
    "Papa",
    "verloren"
   ]
  },
  {
   "start": 7.73,
   "end": 9.63,
   "text": "Rob war 16 Jahre lang Polizist.",
   "highlight": [
    "16",
    "Jahre"
   ]
  },
  {
   "start": 9.77,
   "end": 10.81,
   "text": "Und starb im Einsatz.",
   "highlight": [
    "starb"
   ]
  },
  {
   "start": 10.97,
   "end": 13.11,
   "text": "Heute ist Dakotas erster Schultag ohne ihn.",
   "highlight": [
    "ohne",
    "ihn"
   ]
  },
  {
   "start": 13.25,
   "end": 15.22,
   "text": "Und diesen Weg sollte er nicht allein gehen.",
   "highlight": [
    "allein"
   ]
  },
  {
   "start": 15.34,
   "end": 17.51,
   "text": "Also kam seine ganze Polizei-Familie.",
   "highlight": [
    "ganze",
    "Polizei-Familie"
   ]
  },
  {
   "start": 17.66,
   "end": 18.5,
   "text": "Für seinen Papa.",
   "highlight": [
    "Papa"
   ]
  }
 ],
