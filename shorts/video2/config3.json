  {
   "start": 0.0,
   "end": 1.47,
   "text": "Dutzende Polizisten.",
   "highlight": [
    "Dutzende"
   ]
  },
  {
   "start": 1.73,
   "end": 2.72,
   "text": "Ein Fünfjähriger.",
   "highlight": [
    "Fünfjähriger"
   ]
  },
  {
   "start": 2.87,
   "end": 4.68,
   "text": "Und keiner sagt ein Wort.",
   "highlight": [
    "keiner"
   ]
  },
  {
   "start": 4.92,
   "end": 6.14,
   "text": "Was hat dieser Junge getan?",
   "highlight": [
    "getan?"
   ]
  },
  {
   "start": 6.51,
   "end": 6.95,
   "text": "Nichts.",
   "highlight": [
    "Nichts"
   ]
  },
  {
   "start": 7.29,
   "end": 9.31,
   "text": "Vor zwei Wochen hat er seinen Papa verloren.",
   "highlight": [
    "Papa",
    "verloren"
   ]
  },
  {
   "start": 9.52,
   "end": 11.71,
   "text": "Rob war 16 Jahre lang Polizist.",
   "highlight": [
    "16"
   ]
  },
  {
   "start": 12.11,
   "end": 13.26,
   "text": "Und starb im Einsatz.",
   "highlight": [
    "starb"
   ]
  },
  {
   "start": 13.47,
   "end": 15.83,
   "text": "Heute ist Dakotas erster Schultag ohne ihn.",
   "highlight": [
    "ohne",
    "ihn"
   ]
  },
  {
   "start": 16.03,
   "end": 17.83,
   "text": "Und diesen Weg sollte er nicht allein gehen.",
   "highlight": [
    "allein"
   ]
  },
  {
   "start": 18.04,
   "end": 20.35,
   "text": "Also kam seine ganze Polizei-Familie.",
   "highlight": [
    "Polizei-Familie"
   ]
  },
  {
   "start": 20.72,
   "end": 21.57,
   "text": "Für seinen Papa.",
   "highlight": [
    "Papa"
   ]
  }
 ],
