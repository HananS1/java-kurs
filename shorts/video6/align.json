[
 {
  "start": 0.0,
  "end": 2.44,
  "text": "Die ganze Welt hat dreizehn Jahre auf GTA 6 gewartet."
 },
 {
  "start": 2.44,
  "end": 3.12,
  "text": "Er auch."
 },
 {
  "start": 3.12,
  "end": 4.26,
  "text": "Dann kommt Mama rein."
 },
 {
  "start": 4.26,
  "end": 5.0,
  "text": "Mit einer Tüte."
 },
 {
  "start": 5.0,
  "end": 7.43,
  "text": "Sie drückt sie ihm in die Hand und geht wieder raus."
 },
 {
  "start": 7.43,
  "end": 9.03,
  "text": "Er weiß sofort, was da drin ist."
 },
 {
  "start": 9.03,
  "end": 10.72,
  "text": "Er reißt die Tüte auf… GTA!"
 },
 {
  "start": 10.72,
