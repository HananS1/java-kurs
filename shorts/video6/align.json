 },
 {
  "start": 12.75,
  "end": 14.99,
  "text": "Ein Spiel, das selbst schon dreizehn Jahre alt ist."
 },
 {
  "start": 14.99,
  "end": 15.9,
  "text": "Er sagt nichts."
 },
 {
  "start": 15.9,
  "end": 16.78,
  "text": "Er starrt nur."
 },
 {
  "start": 16.78,
  "end": 17.05,
  "text": "Und dann…"
