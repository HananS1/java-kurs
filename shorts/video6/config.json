  {
   "start": 0.0,
   "end": 2.44,
   "text": "Die ganze Welt hat dreizehn Jahre auf GTA 6 gewartet.",
   "highlight": [
    "dreizehn",
    "GTA"
   ]
  },
  {
   "start": 2.44,
   "end": 3.12,
   "text": "Er auch.",
   "highlight": []
  },
  {
   "start": 3.12,
   "end": 4.26,
   "text": "Dann kommt Mama rein.",
   "highlight": [
    "Mama"
   ]
  },
  {
   "start": 4.26,
   "end": 5.0,
   "text": "Mit einer Tüte.",
   "highlight": [
    "Tüte."
   ]
  },
  {
   "start": 5.0,
   "end": 7.351,
   "text": "Sie stellt sie neben den Fernseher und geht wieder raus.",
   "highlight": [
    "Fernseher"
   ]
  },
  {
   "start": 7.351,
   "end": 8.951,
   "text": "Er weiß sofort, was da drin ist.",
   "highlight": [
    "sofort,"
   ]
  },
  {
   "start": 8.951,
   "end": 10.641,
   "text": "Er reißt die Tüte auf… GTA!",
   "highlight": [
    "GTA!"
   ]
  },
  {
   "start": 10.641,
   "end": 11.071,
   "text": "Aber Moment.",
   "highlight": [
    "Moment."
   ]
  },
  {
   "start": 11.071,
   "end": 11.961,
   "text": "Das ist GTA 5.",
   "highlight": [
    "GTA",
    "5."
   ]
  },
  {
   "start": 11.961,
   "end": 12.671,
   "text": "Für die PS4.",
   "highlight": [
    "PS4."
   ]
  },
  {
   "start": 12.671,
   "end": 14.911,
   "text": "Ein Spiel, das selbst schon dreizehn Jahre alt ist.",
   "highlight": [
    "dreizehn",
    "alt"
   ]
  },
  {
   "start": 14.911,
   "end": 15.821,
   "text": "Er sagt nichts.",
   "highlight": [
    "nichts."
   ]
  },
  {
   "start": 15.821,
   "end": 16.701,
   "text": "Er starrt nur.",
   "highlight": [
    "starrt"
   ]
  },
  {
   "start": 16.701,
   "end": 16.971,
   "text": "Und dann…",
   "highlight": []
  },
  {
   "start": 16.971,
   "end": 18.631,
   "text": "Mama meinte es gut. Wirklich.",
   "highlight": [
    "Mama",
    "gut."
   ]
