  {
   "start": 0.0,
   "end": 2.44,
   "text": "Die ganze Welt hat dreizehn Jahre auf GTA 6 gewartet.",
   "highlight": [
    "dreizehn",
    "GTA"
   ]
  },
  {
   "start": 2.44,
   "end": 3.12,
   "text": "Er auch.",
   "highlight": []
  },
  {
   "start": 3.12,
   "end": 4.26,
   "text": "Dann kommt Mama rein.",
   "highlight": [
    "Mama"
   ]
  },
  {
   "start": 4.26,
   "end": 5.0,
   "text": "Mit einer Tüte.",
   "highlight": [
    "Tüte."
   ]
  },
  {
   "start": 5.0,
   "end": 7.43,
   "text": "Sie drückt sie ihm in die Hand und geht wieder raus.",
   "highlight": []
  },
  {
   "start": 7.43,
   "end": 9.03,
   "text": "Er weiß sofort, was da drin ist.",
   "highlight": [
    "sofort,"
   ]
  },
  {
   "start": 9.03,
   "end": 10.72,
   "text": "Er reißt die Tüte auf… GTA!",
   "highlight": [
    "GTA!"
   ]
  },
  {
   "start": 10.72,
   "end": 11.15,
   "text": "Aber Moment.",
   "highlight": [
    "Moment."
   ]
  },
  {
   "start": 11.15,
   "end": 12.04,
   "text": "Das ist GTA 5.",
   "highlight": [
    "GTA",
    "5."
   ]
  },
  {
   "start": 12.04,
   "end": 12.75,
   "text": "Für die PS4.",
   "highlight": [
    "PS4."
   ]
  },
  {
   "start": 12.75,
   "end": 14.99,
   "text": "Ein Spiel, das selbst schon dreizehn Jahre alt ist.",
   "highlight": [
    "dreizehn",
    "alt"
   ]
  },
  {
   "start": 14.99,
   "end": 15.9,
   "text": "Er sagt nichts.",
   "highlight": [
    "nichts."
   ]
  },
  {
   "start": 15.9,
   "end": 16.78,
   "text": "Er starrt nur.",
   "highlight": [
    "starrt"
   ]
  },
  {
   "start": 16.78,
   "end": 17.05,
   "text": "Und dann…",
   "highlight": []
  },
  {
   "start": 17.05,
   "end": 18.71,
   "text": "Mama meinte es gut. Wirklich.",
   "highlight": [
    "Mama",
    "gut."
   ]
  }
